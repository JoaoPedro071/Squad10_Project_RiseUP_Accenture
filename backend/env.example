# Ambiente: development (padrao) ou production.
APP_ENV=development

# Enderecos dos front-ends que podem chamar a API (separados por virgula).
# Vazio = http://localhost:3000 (dashboard) e http://localhost:3001 (player).
# "*" libera qualquer site: so para testes locais; e recusado em production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Segundos sem sinal de vida ate a tela ser considerada desligada.
HEARTBEAT_TIMEOUT_SECONDS=15

# Banco de dados. Vazio = arquivo SQLite experience-manager.db na pasta backend.
DATABASE_URL=sqlite:///./experience-manager.db

# Login do dashboard: horas ate a sessao expirar.
SESSION_HOURS=12
# true = cookie de sessao so por HTTPS (sempre ligado quando APP_ENV=production).
COOKIE_SECURE=false
